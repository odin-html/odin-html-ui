{
  "element": "oh-timepicker",
  "display": "contents",
  "selectors": {
    "trigger": "[data-oh-timepicker-trigger]",
    "display": "[data-oh-timepicker-display]",
    "hiddenInput": "[data-oh-timepicker-hidden-input]",
    "popup": "[data-oh-timepicker-popup]",
    "hourList": "[data-oh-timepicker-hour-list]",
    "minuteList": "[data-oh-timepicker-minute-list]",
    "done": "[data-oh-timepicker-done]",
    "popoverContent": "[popover]"
  },
  "attributes": {

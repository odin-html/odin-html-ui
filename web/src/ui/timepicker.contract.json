    "minTime": "data-oh-timepicker-min-time",
    "maxTime": "data-oh-timepicker-max-time",
    "placeholder": "data-oh-timepicker-placeholder",
    "hour": "data-oh-timepicker-hour",
    "minute": "data-oh-timepicker-minute",
    "period": "data-oh-timepicker-period",
